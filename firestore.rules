rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configuración general del sitio web
    match /site_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Configuración del portafolio por servicio
    match /portfolio_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Solicitudes de contacto e interacción
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
